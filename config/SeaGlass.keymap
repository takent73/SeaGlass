#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#undef ZMK_POINTING_DEFAULT_SCRL_VAL

#define ZMK_POINTING_DEFAULT_SCRL_VAL 120

&mt {
    flavor = "balanced";
    quick-tap-ms = <175>;
    tapping-term-ms = <275>;
    require-prior-idle-ms = <150>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <175>;
    tapping-term-ms = <275>;
    require-prior-idle-ms = <150>;
};

/ {
    runtime_combo_defaults {
        compatible = "cormoran,runtime-combo-defaults";

        middle-click {
            slot = <0>;
            bindings = <&mkp MB3>;
            key-positions = <40 41>;
            display-name = "Middle Click";
        };

        tab {
            slot = <1>;
            bindings = <&kp TAB>;
            key-positions = <10 11>;
            layers = <0>;
            display-name = "Tab";
        };

        backspace {
            slot = <2>;
            bindings = <&kp BACKSPACE>;
            key-positions = <8 9>;
            layers = <0>;
            display-name = "Backspace";
        };

        input_eisu {
            slot = <3>;
            bindings = <&kp LANG2>;
            key-positions = <34 24>;
            layers = <0>;
            display-name = "Eisu";
        };

        input_kana {
            slot = <4>;
            bindings = <&kp LANG1>;
            key-positions = <35 25>;
            layers = <0>;
            display-name = "Kana";
        };

        escape {
            slot = <5>;
            bindings = <&kp ESC>;
            key-positions = <1 0>;
            layers = <0>;
            display-name = "Escape";
        };
    };

    behaviors {
        rsr_scroll_ud: rsr_scroll_ud {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc SCRL_UP>;
            ccw-binding = <&msc SCRL_DOWN>;
        };

        rsr_scroll_lr: rsr_scroll_lr {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc SCRL_RIGHT>;
            ccw-binding = <&msc SCRL_LEFT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Default {
            bindings = <
&kp Q    &kp W           &kp E        &kp R             &kp T      &kp Y          &kp U             &kp I        &kp O           &kp P
&kp A    &mt LEFT_ALT S  &mt LCTRL D  &mt LEFT_SHIFT F  &kp G      &kp H          &mt LEFT_SHIFT J  &mt LCTRL K  &mt LEFT_ALT L  &kp MINUS
&kp Z    &kp X           &kp C        &kp V             &kp B      &kp N          &kp M             &kp COMMA    &kp PERIOD      &kp SLASH
&kp DEL  &kp TAB         &mo 1        &mo 3             &kp SPACE  &kp BACKSPACE  &kp ENTER         &mo 2        &kp LEFT_GUI    &kp ESCAPE
                                                                   &mkp MB1       &mkp MB2
            >;

            sensor-bindings = <&rsr_scroll_ud &rsr_scroll_lr>;
        };

        Number {
            bindings = <
&none            &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &none      &none     &none           &kp UP_ARROW    &none            &none
&kp KP_NUMBER_0  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp F4     &none     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none
&kp KP_DOT       &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp COLON  &kp PLUS  &kp MINUS       &kp ASTERISK    &kp SLASH        &kp EQUAL
&kp LEFT_ALT     &kp LCTRL        &kp LEFT_SHIFT   &none            &kp SPACE  &kp DEL   &kp ENTER       &mo 4           &none            &kp ESC
                                                                               &mkp MB1  &mkp MB2
            >;
        };

        Symbol {
            bindings = <
&kp SQT       &kp DQT        &kp EXCLAMATION  &none     &kp TILDE      &none      &kp LBRC  &kp RBRC  &none           &kp PERCENT
&kp AT        &kp SEMICOLON  &kp DOLLAR       &none     &kp HASH       &kp CARET  &kp LPAR  &kp RPAR  &none           &none
&none         &none          &kp COLON        &kp PIPE  &kp BACKSLASH  &kp AMPS   &kp LBKT  &kp RBKT  &none           &none
&kp LEFT_ALT  &kp LCTRL      &kp LEFT_SHIFT   &none     &kp SPACE      &none      &none     &none     &kp LANGUAGE_1  &kp LANGUAGE_2
                                                                       &mkp MB1   &mkp MB2
            >;
        };

        Arrow {
            bindings = <
&none       &kp LA(LEFT_ARROW)  &kp UP_ARROW    &kp LA(RIGHT_ARROW)  &none      &none       &kp CAPS        &kp TAB    &none         &none
&kp HOME    &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &kp END    &none       &kp LEFT_SHIFT  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI
&none       &kp PAGE_UP         &none           &kp PAGE_DOWN        &none      &none       &none           &none      &none         &none
&kp ESCAPE  &none               &none           &kp DEL              &kp ENTER  &kp DELETE  &kp ENTER       &none      &none         &none
                                                                                &mkp MB1    &mkp MB2
            >;
        };

        Function {
            bindings = <
&none    &kp F7  &kp F8  &kp F9  &none  &none           &none         &none         &none         &none
&kp F10  &kp F4  &kp F5  &kp F6  &none  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none    &kp F1  &kp F2  &kp F3  &none  &studio_unlock  &none         &none         &none         &none
&none    &none   &none   &none   &none  &none           &none         &none         &none         &bt BT_CLR
                                        &mkp MB1        &mkp MB2
            >;
        };
    };
};
